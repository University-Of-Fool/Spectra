  "query": "\n            SELECT * FROM items\n            WHERE creator = $1 \n            AND EXISTS(\n                SELECT 1 FROM file_metadata\n                WHERE items.id = file_metadata.item_id\n                AND file_metadata.img = TRUE\n            )\n            ORDER BY created_at DESC\n            LIMIT $2 OFFSET $3\n            ",
